# PostgreSQL Database Configuration (Local Development)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/task_management_local
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Google OAuth2 Configuration
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Configuration
# Generate a secure key: openssl rand -base64 32
# For HS256 (HMAC-SHA256), recommend 256 bits (32 bytes) or longer
JWT_SECRET=my-super-secret-key-that-must-be-at-least-32-characters-long-for-hs256

# Database (optional, for local setup)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional: frontend URL for CORS
FRONTEND_URL=http://localhost:3000
